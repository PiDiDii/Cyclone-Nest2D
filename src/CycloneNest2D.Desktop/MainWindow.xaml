<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CycloneNest2D.UI;assembly=CycloneNest2D.UI.Core"
        xmlns:local="clr-namespace:CycloneNest2D.Desktop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Class="CycloneNest2D.Desktop.MainWindow"
        Title="{Binding Title}"
        Width="1560" Height="900" MinWidth="1100" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" FontFamily="{StaticResource AppFont}" FontSize="13.5"
 Foreground="{DynamicResource TextPrimaryBrush}" StateChanged="Window_StateChanged"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveProjectCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding AddDxfCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate x:Key="LayerTemplate"><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="3,2"><TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Note, Mode=OneWay}" Foreground="Gray"/></TextBlock></CheckBox></DataTemplate>
    <Style x:Key="CloseGlyph" TargetType="Path">
 <Setter Property="Stroke" Value="{DynamicResource IconStrokeBrush}"/>
 <Style.Triggers>
 <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
 <Setter Property="Stroke" Value="White"/>
 </DataTrigger>
 </Style.Triggers>
 </Style>
 </Window.Resources>


 <!-- ROOT: thanh trên / thanh công cụ / (sidebar + nội dung) / thanh trạng thái -->
 <Grid x:Name="RootLayout">
 <Grid.RowDefinitions>
 <RowDefinition Height="56"/>
 <RowDefinition Height="*"/>
 <RowDefinition Height="40"/>
 </Grid.RowDefinitions>

 <!-- ================= THANH TRÊN ================= -->
 <Border Grid.Row="0" Background="{DynamicResource TopBarBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
 <Grid>
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
 </Grid.ColumnDefinitions>

 <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,16,0">
 <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource PrimaryBrush}" Margin="0,0,11,0">
 <Path Data="{StaticResource IcNesting}" Style="{StaticResource Ico}" Stroke="{DynamicResource OnPrimaryBrush}" Width="18" Height="18"/>
 </Border>
 <TextBlock Text="CYCLONE NEST2D" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
 </StackPanel>

 <Button Grid.Column="1" x:Name="ProjectButton" Style="{StaticResource ToolbarButton}" Click="ProjectMenu_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Menu dự án">
 <StackPanel Orientation="Horizontal">
 <Path Data="{StaticResource IcFolderOpen}" Style="{StaticResource Ico}" Width="19" Height="19" Margin="0,0,9,0"/>
 <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
 <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" Margin="8,0,0,0" ToolTip="Có thay đổi chưa lưu trong dự án" Visibility="{Binding IsProjectDirty, Converter={StaticResource B2V}}"/>
 <Path Data="{StaticResource IcChevDown}" Style="{StaticResource Ico}" Width="12" Height="12" Margin="9,0,0,0"/>
 </StackPanel>
 <Button.ContextMenu>
 <ContextMenu x:Name="ProjectMenu">
 <MenuItem Header="Dự án mới" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N"/>
 <MenuItem Header="Mở dự án..." Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O"/>
 <Separator/>
 <MenuItem Header="Lưu" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S"/>
 <MenuItem Header="Lưu thành..." Command="{Binding SaveProjectAsCommand}"/>
 </ContextMenu>
 </Button.ContextMenu>
 </Button>

 <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
 <Button x:Name="ThemeButton" Style="{StaticResource WindowButton}" Click="ToggleTheme_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Đổi giao diện Sáng / Tối" Width="44">
 <Path x:Name="ThemeIcon" Data="{StaticResource IcSun}" Style="{StaticResource Ico}" Width="19" Height="19"/>
 </Button>
 <Button Style="{StaticResource WindowButton}" Click="WindowMinimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Thu nhỏ">
 <Path Data="M0,6 H12" Width="12" Height="12" Stretch="None" Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.3"/>
 </Button>
 <Button Style="{StaticResource WindowButton}" Click="WindowMaximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Phóng to / Khôi phục">
 <Grid Width="12" Height="12">
 <Path x:Name="MaxGlyph" Data="M0.5,0.5 H11.5 V11.5 H0.5 Z" Stretch="None" Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.3"/>
 <Path x:Name="RestoreGlyph" Data="M3,0.5 H11.5 V9 M0.5,3 H9 V11.5 H0.5 Z" Stretch="None" Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.3" Visibility="Collapsed"/>
 </Grid>
 </Button>
 <Button Style="{StaticResource WindowCloseButton}" Click="WindowClose_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Đóng" Width="50">
 <Path Data="M0,0 L12,12 M12,0 L0,12" Width="12" Height="12" Stretch="None" Style="{StaticResource CloseGlyph}" StrokeThickness="1.3"/>
 </Button>
 </StackPanel>
 </Grid>
 </Border>

 <Grid Grid.Row="1">
 <Grid.ColumnDefinitions><ColumnDefinition Width="98"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

 <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
 <StackPanel Margin="0,10,0,0">
 <RadioButton x:Name="NavFile" Tag="0" GroupName="MainNavigation" Style="{StaticResource RailNavButton}" Click="TabNav_Click" ToolTip="Tổng quan">
 <StackPanel HorizontalAlignment="Center">
 <Path Data="{StaticResource IcHome}" Style="{StaticResource NavIco}" Width="24" Height="24"/>
 <TextBlock Text="Tổng quan" HorizontalAlignment="Center" Margin="0,6,0,0"/>
 </StackPanel>
 </RadioButton>
 <RadioButton x:Name="NavPart" Tag="1" GroupName="MainNavigation" Style="{StaticResource RailNavButton}" Click="TabNav_Click" ToolTip="Part">
 <StackPanel HorizontalAlignment="Center">
 <Path Data="{StaticResource IcPart}" Style="{StaticResource NavIco}" Width="24" Height="24"/>
 <TextBlock Text="Part" HorizontalAlignment="Center" Margin="0,6,0,0"/>
 </StackPanel>
 </RadioButton>
 <RadioButton x:Name="NavSheets" Tag="2" GroupName="MainNavigation" Style="{StaticResource RailNavButton}" Click="TabNav_Click" ToolTip="Sheets">
 <StackPanel HorizontalAlignment="Center">
 <Path Data="{StaticResource IcSheets}" Style="{StaticResource NavIco}" Width="24" Height="24"/>
 <TextBlock Text="Sheets" HorizontalAlignment="Center" Margin="0,6,0,0"/>
 </StackPanel>
 </RadioButton>
 <RadioButton x:Name="NavNesting" Tag="3" GroupName="MainNavigation" IsChecked="True" Style="{StaticResource RailNavButton}" Click="TabNav_Click" ToolTip="Nesting">
 <StackPanel HorizontalAlignment="Center">
 <Path Data="{StaticResource IcNesting}" Style="{StaticResource NavIco}" Width="24" Height="24"/>
 <TextBlock Text="Nesting" HorizontalAlignment="Center" Margin="0,6,0,0"/>
 </StackPanel>
 </RadioButton>
 <RadioButton x:Name="NavExport" Tag="4" GroupName="MainNavigation" Style="{StaticResource RailNavButton}" Click="TabNav_Click" ToolTip="Export">
 <StackPanel HorizontalAlignment="Center">
 <Path Data="{StaticResource IcExport}" Style="{StaticResource NavIco}" Width="24" Height="24"/>
 <TextBlock Text="Export" HorizontalAlignment="Center" Margin="0,6,0,0"/>
 </StackPanel>
 </RadioButton>
 <RadioButton x:Name="NavSetup" Tag="5" GroupName="MainNavigation" Style="{StaticResource RailNavButton}" Click="TabNav_Click" ToolTip="Thiết lập">
 <StackPanel HorizontalAlignment="Center">
 <Path Data="{StaticResource IcSettings}" Style="{StaticResource NavIco}" Width="24" Height="24"/>
 <TextBlock Text="Thiết lập" HorizontalAlignment="Center" Margin="0,6,0,0"/>
 </StackPanel>
 </RadioButton>
 <RadioButton x:Name="NavInfo" Tag="6" GroupName="MainNavigation" Style="{StaticResource RailNavButton}" Click="TabNav_Click" ToolTip="Thông tin">
 <StackPanel HorizontalAlignment="Center">
 <Path Data="{StaticResource IcInfo}" Style="{StaticResource NavIco}" Width="24" Height="24"/>
 <TextBlock Text="Thông tin" HorizontalAlignment="Center" Margin="0,6,0,0"/>
 </StackPanel>
 </RadioButton>
 </StackPanel>
 </Border>

 <Grid Grid.Column="1">
                <TabControl x:Name="MainTabs" SelectedIndex="3" Background="Transparent" BorderThickness="0" Padding="0" Margin="0">
            <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><TabPanel IsItemsHost="True" Visibility="Collapsed"/><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0"/></Grid></ControlTemplate></TabControl.Template>
            <TabItem Header="File">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="940" HorizontalAlignment="Left">
                    <TextBlock Text="Quản lý dự án" Style="{StaticResource SectionTitle}"/><TextBlock Text="Tạo mới, mở hoặc lưu trạng thái nesting hiện tại." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,18"/>
                    <WrapPanel><Button Content="Dự án mới" Command="{Binding NewProjectCommand}" ToolTip="Ctrl+N"/><Button Content="Mở dự án..." Command="{Binding OpenProjectCommand}" ToolTip="Ctrl+O"/><Button Content="Lưu" Command="{Binding SaveProjectCommand}" ToolTip="Ctrl+S"/><Button Content="Lưu thành..." Command="{Binding SaveProjectAsCommand}"/></WrapPanel>
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0"><StackPanel><TextBlock Text="Dự án đang mở" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding Title}" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding Status}" Margin="0,5,0,0" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Nhóm vật liệu trong dự án" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Mỗi nhóm lưu danh sách chi tiết, khổ tấm và kết quả nesting riêng." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                            <ComboBox ItemsSource="{Binding ProjectGroups}" SelectedItem="{Binding SelectedProjectGroup, Mode=TwoWay}" DisplayMemberPath="Name" MinWidth="300" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding SelectedProjectGroup.Summary}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,10"/>
                            <TextBox Text="{Binding NewProjectGroupName, UpdateSourceTrigger=PropertyChanged}" MinWidth="300" MaxWidth="420" HorizontalAlignment="Left" ToolTip="Nhập tên nhóm để tạo mới hoặc đổi tên nhóm đang chọn"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Tạo nhóm" Command="{Binding CreateProjectGroupCommand}"/>
                                <Button Content="Đổi tên" Command="{Binding RenameProjectGroupCommand}"/>
                                <Button Content="Nhân bản" Command="{Binding DuplicateProjectGroupCommand}"/>
                                <Button Content="Gỡ nhóm" Command="{Binding RemoveProjectGroupCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="Gỡ nhóm chỉ bỏ liên kết khỏi dự án, file nhóm vẫn được giữ lại." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Phím tắt: Ctrl+N dự án mới · Ctrl+O mở · Ctrl+S lưu · Ctrl+D thêm DXF · F5 chạy nesting." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Part">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12"><StackPanel><TextBlock Text="Quản lý chi tiết" Style="{StaticResource SectionTitle}"/><TextBlock Text="Nhấp chuột phải để chọn dòng, sửa thuộc tính hoặc xóa; có thể chọn nhiều dòng để áp dụng thuộc tính hàng loạt." Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></DockPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="320"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*" MinWidth="250"/></Grid.ColumnDefinitions><GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeWE" ToolTip="Kéo để đổi kích thước"/>
                        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top"><WrapPanel Margin="0,0,0,10"><Button Command="{Binding AddDxfCommand}" ToolTip="Ctrl+D"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcPlus}" Style="{StaticResource Ico}" Width="13" Height="13" Margin="0,0,6,0"/><TextBlock Text="Thêm DXF" VerticalAlignment="Center"/></StackPanel></Button><Button Content="Thêm thư mục" Command="{Binding AddFolderCommand}"/></WrapPanel></StackPanel>
                            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0"><TextBlock x:Name="PartSelectionSummary" Text="0 dòng chi tiết" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/></Grid><DataGrid x:Name="PartsGrid" ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AllowDrop="True" IsEnabled="{Binding IsIdle}" PreviewMouseRightButtonDown="PartsGrid_PreviewMouseRightButtonDown" PreviewKeyDown="PartsGrid_PreviewKeyDown" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource PartListBorderBrush}" BorderThickness="1" RowBackground="{DynamicResource CardBgBrush}" AlternatingRowBackground="{DynamicResource CardBgAltBrush}" RowStyle="{StaticResource PartRowStyle}" ColumnHeaderStyle="{StaticResource CenteredHeader}" CellStyle="{StaticResource CenteredCell}" RowHeight="29" SelectionChanged="PartsGrid_SelectionChanged" Loaded="PartsGrid_Loaded" CellEditEnding="PartsGrid_CellEditEnding">
                                <DataGrid.ContextMenu><ContextMenu Opened="PartsContextMenu_Opened"><MenuItem Header="Chọn tất cả" Click="SelectAllParts_Click"/><MenuItem Header="Bỏ chọn" Click="ClearPartSelection_Click"/><Separator/><MenuItem Header="Sửa / Thuộc tính…" Click="EditSelectedPartProperties_Click" Tag="requires-selection"/><Separator/><MenuItem Header="Xóa dòng đã chọn" Click="DeleteSelectedParts_Click" Tag="requires-selection"/><MenuItem Header="Xóa tất cả chi tiết…" Click="DeleteAllParts_Click"/></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns>
                                    <DataGridTextColumn Header="STT" Binding="{Binding Sequence, Mode=OneWay}" ElementStyle="{StaticResource CenteredText}" IsReadOnly="True" Width="48"/><DataGridTextColumn Header="Tên" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource CenteredText}" EditingElementStyle="{StaticResource CenteredEditor}" Width="*"/><DataGridTextColumn Header="SL" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource CenteredText}" EditingElementStyle="{StaticResource CenteredEditor}" Width="54"/><DataGridTextColumn Header="Rộng (mm)" Binding="{Binding Width, Mode=OneWay, StringFormat='{}{0:0.##}'}" ElementStyle="{StaticResource CenteredText}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="Cao (mm)" Binding="{Binding Height, Mode=OneWay, StringFormat='{}{0:0.##}'}" ElementStyle="{StaticResource CenteredText}" IsReadOnly="True" Width="90"/><DataGridTemplateColumn Header="Vật liệu · Độ dày" Width="250"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Presets, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" SelectedItem="{Binding AssignedPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="AssignmentLabel" Padding="4,2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridCheckBoxColumn Header="Xoay" Binding="{Binding CanRotate, Mode=TwoWay}" Width="76"/><DataGridCheckBoxColumn Header="Lật hình" Binding="{Binding Flip, Mode=TwoWay}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid></DockPanel></Border>
                        <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="210"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel Grid.Row="0"><Button DockPanel.Dock="Right" Content="Fit Zoom" Click="PartPreviewFitZoom_Click" Padding="9,5" Margin="8,0,0,0" ToolTip="Đưa chi tiết vừa khung xem trước"/><StackPanel><TextBlock Text="Xem trước chi tiết" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding SelectedPart.Name, TargetNullValue=Chưa chọn chi tiết}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,2"/><TextBlock Text="{Binding SelectedPart.Info, TargetNullValue=Chọn một dòng để xem thông tin}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/></StackPanel></DockPanel>
                            <TextBlock Grid.Row="1" Text="Layer DXF" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,3"/>
                            <Border Grid.Row="2" Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,8" MaxHeight="100"><ListBox ItemsSource="{Binding SelectedPart.Layers}" ItemTemplate="{StaticResource LayerTemplate}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"/></Border>
                            <Border Grid.Row="3" Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" MinHeight="210"><local:PartPreviewView x:Name="PartPreview" Part="{Binding SelectedPart}"/></Border>
                            <TextBlock Grid.Row="4" Text="Con lăn chuột để zoom · Fit Zoom để căn vừa khung · bật/tắt layer để cập nhật hình" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="2,5,0,0"/>
                        </Grid></Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Sheets">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False"><StackPanel><TextBlock Text="Quản lý tấm vật liệu" Style="{StaticResource SectionTitle}"/><TextBlock Text="Nhấp đúp hoặc chọn một ô để nhập trực tiếp; nhấp chuột phải để thêm, xóa hoặc chọn nhiều dòng." Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></DockPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*" MinWidth="280"/></Grid.ColumnDefinitions><GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeWE" ToolTip="Kéo để đổi kích thước"/>
                        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Top" Text="DANH MỤC VẬT LIỆU · ĐỘ DÀY · KHỔ TẤM" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="5,2,0,8"/>
                            <DataGrid x:Name="SheetPresetsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" IsEnabled="{Binding IsIdle}" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource PartListBorderBrush}" BorderThickness="1" RowBackground="{DynamicResource CardBgBrush}" AlternatingRowBackground="{DynamicResource CardBgAltBrush}" RowStyle="{StaticResource PartRowStyle}" ColumnHeaderStyle="{StaticResource CenteredHeader}" CellStyle="{StaticResource CenteredCell}" RowHeight="34" SelectionChanged="SheetPresetsGrid_SelectionChanged" PreviewMouseRightButtonDown="SheetPresetsGrid_PreviewMouseRightButtonDown" RowEditEnding="SheetPresetsGrid_RowEditEnding" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.ContextMenu><ContextMenu Opened="SheetPresetsContextMenu_Opened"><MenuItem Header="Chọn tất cả" Click="SelectAllSheetPresets_Click"/><MenuItem Header="Hủy chọn" Click="ClearSheetPresetSelection_Click"/><Separator/><MenuItem Header="Thêm khổ tấm" Click="AddSheetPresetRow_Click"/><MenuItem Header="Xóa tấm đã chọn" Click="DeleteSelectedSheetPresets_Click" Tag="requires-selection"/></ContextMenu></DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STT" Binding="{Binding Sequence, Mode=OneWay}" ElementStyle="{StaticResource CenteredText}" IsReadOnly="True" Width="42"/>
                                    <DataGridTextColumn Header="Tên vật liệu" Binding="{Binding Material, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource CenteredText}" EditingElementStyle="{StaticResource CenteredEditor}" Width="138"/>
                                    <DataGridTextColumn Header="Dài (mm)" Binding="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" ElementStyle="{StaticResource CenteredText}" EditingElementStyle="{StaticResource CenteredEditor}" Width="112"/>
                                    <DataGridTextColumn Header="Rộng (mm)" Binding="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" ElementStyle="{StaticResource CenteredText}" EditingElementStyle="{StaticResource CenteredEditor}" Width="116"/>
                                    <DataGridTextColumn Header="Độ dày (mm)" Binding="{Binding Thickness, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" ElementStyle="{StaticResource CenteredText}" EditingElementStyle="{StaticResource CenteredEditor}" Width="124"/>
                                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource CenteredText}" EditingElementStyle="{StaticResource CenteredEditor}" Width="230"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel></Border>
                        <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="VẬT LIỆU · ĐỘ DÀY · KHỔ TẤM" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock Text="{Binding SelectedPreset.Material, TargetNullValue=Chưa chọn vật liệu}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,3"/><StackPanel Orientation="Horizontal" Margin="0,2,0,4"><TextBlock Text="{Binding SelectedPreset.Thickness, StringFormat='{}{0:0.##}'}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text=" mm" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="{Binding SelectedPreset.Width, StringFormat='{}{0:0.##}'}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text=" × " Foreground="{DynamicResource TextMutedBrush}"/><TextBlock Text="{Binding SelectedPreset.Height, StringFormat='{}{0:0.##}'}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text=" mm" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><Separator/><TextBlock Text="Thông số dùng chung" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,6"/><TextBlock Text="Lề an toàn (mm)" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Field}" Text="{Binding Settings.Margin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Khe hở chi tiết (mm)" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Field}" Text="{Binding Settings.Spacing, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Danh sách vật liệu, độ dày và khổ được lưu trong cấu hình/dự án." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Border>
                    </Grid>
                </Grid>
            </TabItem>
 <TabItem Header="Nesting">
 <Grid Margin="14,12,14,12">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border Style="{StaticResource CardFlat}" Padding="10,6" Margin="0,0,0,10">
 <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
 <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}" Padding="18,0" Height="40" Margin="0,0,6,0" ToolTip="Chạy nesting (F5)">
 <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcPlay}" Style="{StaticResource IcoSolid}" Width="13" Height="13" Fill="{DynamicResource OnPrimaryBrush}" Margin="0,0,9,0"/><TextBlock Text="Chạy Nesting" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource OnPrimaryBrush}"/></StackPanel>
 </Button>
 <Button Command="{Binding CancelCommand}" Padding="14,8" Margin="0" ToolTip="Dừng và giữ kết quả tốt nhất hiện có">
 <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcStop}" Style="{StaticResource IcoSolid}" Width="14" Height="14" Margin="0,0,8,0"/><TextBlock Text="Dừng" VerticalAlignment="Center"/></StackPanel>
 </Button>
 </StackPanel>
 </Border>
 <Grid Grid.Row="1">
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="330" MinWidth="260"/>
 <ColumnDefinition Width="12"/>
 <ColumnDefinition Width="*" MinWidth="360"/>
 <ColumnDefinition Width="12"/>
 <ColumnDefinition Width="340" MinWidth="270"/>
 </Grid.ColumnDefinitions>
 <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeWE" ToolTip="Kéo để đổi kích thước"/>
 <GridSplitter Grid.Column="3" Width="12" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeWE" ToolTip="Kéo để đổi kích thước"/>

 <!-- ===== TRÁI: THIẾT LẬP NESTING + BỘ LỌC CHI TIẾT ===== -->
 <!-- ===== TRÁI: BỘ LỌC CHI TIẾT (kéo part vào sheet để xếp thủ công) ===== -->
 <Border Grid.Column="0" Style="{StaticResource CardFlat}" Padding="0">
 <Grid>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <StackPanel Grid.Row="0" Margin="16,12,12,8">
 <DockPanel LastChildFill="False">
 <TextBlock Text="Bộ lọc chi tiết" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
 </DockPanel>
 <TextBlock Text="Kéo một chi tiết vào tấm để đặt thủ công. Dùng mũi tên để đẩy tới vật cản; Shift + mũi tên nhích 1 mm." Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
 </StackPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="NestingPartsScrollViewer" CanContentScroll="False" Padding="10,0,10,10">
 <ItemsControl ItemsSource="{Binding PartGroups}" x:Name="NestingPartGroupsControl"
                                              Loaded="ScheduleNestingPartColumnAutoFit">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10" Padding="0,0,0,6">
                                                <Expander IsExpanded="True" Margin="4,2">
                                                    <Expander.Header>
                                                        <DockPanel LastChildFill="True" Margin="0,4,4,4">
                                                            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentTintBrush}" CornerRadius="8" Padding="8,3" Margin="8,0,0,0">
                                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryDarkBrush}">
                                                                    <Run Text="{Binding TotalQuantity, Mode=OneWay}"/><Run Text=" parts"/>
                                                                </TextBlock>
                                                            </Border>
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </Expander.Header>
                                                    <ListBox ItemsSource="{Binding Parts}" PreviewMouseLeftButtonDown="NestingPart_PreviewMouseLeftButtonDown" PreviewMouseMove="NestingPart_PreviewMouseMove"
                                                             SelectedItem="{Binding DataContext.SelectedPart, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                                                             BorderThickness="0" Background="Transparent"
                                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="Padding" Value="6,4"/>
                                                                <Setter Property="Margin" Value="2,1"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ListBoxItem">
                                                                            <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsSelected" Value="True">
                                                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="32"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Width="28" Height="24" VerticalAlignment="Center">
                                                                        <local:PartPreviewView Part="{Binding}" Width="24" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               VerticalAlignment="Center" Margin="8,0,6,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                                    <Border Grid.Column="2" Background="{DynamicResource AppBorderBrush}" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}">
                                                                            <Run Text="×"/><Run Text="{Binding RemainingQuantity, Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Expander>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
 </ScrollViewer>
 </Grid>
 </Border>

 <!-- ===== GIỮA: KHUNG XEM TẤM ===== -->
 <Grid Grid.Column="2">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border Grid.Row="0" Style="{StaticResource CardFlat}" Padding="8,6" Margin="0,0,0,10">
 <DockPanel LastChildFill="False">
 <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
 <Button Click="PreviousSheet_Click" Padding="9,6" Margin="0" ToolTip="Tấm trước"><Path Data="{StaticResource IcPrev}" Style="{StaticResource Ico}" Width="14" Height="14"/></Button>
 <Border Background="{DynamicResource CardBgHoverBrush}" CornerRadius="7" Padding="14,6" Margin="4,0">
 <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"><Run Text="Tấm "/><Run Text="{Binding SelectedSheet.Sheet.Index, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Sheets.Count, Mode=OneWay}"/></TextBlock>
 </Border>
 <Button Click="NextSheet_Click" Padding="9,6" Margin="0,0,10,0" ToolTip="Tấm tiếp theo"><Path Data="{StaticResource IcNext}" Style="{StaticResource Ico}" Width="14" Height="14"/></Button>
 <Button Command="{Binding DeleteSelectedSheetCommand}" Padding="9,6" Margin="0,0,8,0" ToolTip="Xóa toàn bộ nesting của tấm đang chọn">
 <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcTrash}" Style="{StaticResource Ico}" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Xóa" VerticalAlignment="Center"/></StackPanel>
 </Button>
 <RadioButton GroupName="CanvasTools" IsChecked="True" Style="{StaticResource NavButton}" Padding="9,6" Margin="0,0,3,0" ToolTip="Chọn và kéo chi tiết" Click="PointerTool_Click"><Path Data="{StaticResource IcSelect}" Style="{StaticResource Ico}" Width="16" Height="16"/></RadioButton>
 <RadioButton GroupName="CanvasTools" Style="{StaticResource NavButton}" Padding="9,6" Margin="0,0,3,0" ToolTip="Kéo để di chuyển khung nhìn" Click="PanTool_Click"><Path Data="{StaticResource IcPan}" Style="{StaticResource Ico}" Width="16" Height="16"/></RadioButton>
 <RadioButton GroupName="CanvasTools" Style="{StaticResource NavButton}" Padding="9,6" Margin="0,0,3,0" ToolTip="Kéo vùng để phóng to" Click="ZoomRectangleTool_Click"><Path Data="{StaticResource IcZoomBox}" Style="{StaticResource Ico}" Width="16" Height="16"/></RadioButton>
 </StackPanel>
 <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
 <Button Click="FitView_Click" Padding="11,6" Margin="0,0,6,0" ToolTip="Vừa tấm vào khung nhìn"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcFit}" Style="{StaticResource Ico}" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Fit" VerticalAlignment="Center"/></StackPanel></Button>
 <Button Click="ZoomOut_Click" Padding="9,6" Margin="0,0,2,0" ToolTip="Thu nhỏ"><Path Data="{StaticResource IcMinus}" Style="{StaticResource Ico}" Width="14" Height="14"/></Button>
 <ComboBox x:Name="ZoomPresetBox" Width="86" IsEditable="True" IsReadOnly="True" Margin="1,0" SelectionChanged="ZoomPreset_SelectionChanged">
 <ComboBoxItem Content="Fit" Tag="Fit"/><ComboBoxItem Content="50%" Tag="50"/><ComboBoxItem Content="75%" Tag="75"/><ComboBoxItem Content="100%" Tag="100"/><ComboBoxItem Content="125%" Tag="125"/><ComboBoxItem Content="150%" Tag="150"/><ComboBoxItem Content="200%" Tag="200"/>
 </ComboBox>
 <Button Click="ZoomIn_Click" Padding="9,6" Margin="2,0,0,0" ToolTip="Phóng to"><Path Data="{StaticResource IcPlus}" Style="{StaticResource Ico}" Width="14" Height="14"/></Button>
 </StackPanel>
 </DockPanel>
 </Border>

 <Border Grid.Row="1" Style="{StaticResource CardFlat}" Padding="0" ClipToBounds="True">
 <Grid>
 <local:SheetView x:Name="SheetCanvas" Scene="{Binding Scene}" SelectedIndex="{Binding SelectedPlacement, Mode=TwoWay}" Model="{Binding}" AllowDrop="True"/>
 <Border Background="{DynamicResource OverlayCardBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsStale, Converter={StaticResource B2V}}" IsHitTestVisible="False">
 <TextBlock Text="Danh sách chi tiết hoặc thông số đã đổi.&#10;Chạy nesting lại trước khi tiếp tục chỉnh sửa." TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13.5"/>
 </Border>
 <Border Background="{DynamicResource OverlayCardBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
 <Border.Style>
 <Style TargetType="Border">
 <Setter Property="Visibility" Value="Collapsed"/>
 <Style.Triggers><DataTrigger Binding="{Binding Result}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
 </Style>
 </Border.Style>
 <StackPanel HorizontalAlignment="Center" MaxWidth="320">
 <TextBlock Text="Chưa có bố trí" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
 <TextBlock Text="Kéo một chi tiết từ Bộ lọc chi tiết vào tấm để bắt đầu xếp thủ công, hoặc chạy tự động." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,14" TextAlignment="Center" TextWrapping="Wrap"/>
 <Button Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcPlay}" Style="{StaticResource IcoSolid}" Width="12" Height="12" Fill="{DynamicResource OnPrimaryBrush}" Margin="0,0,8,0"/><TextBlock Text="Chạy Nesting" VerticalAlignment="Center" Foreground="{DynamicResource OnPrimaryBrush}"/></StackPanel></Button>
 </StackPanel>
 </Border>
 </Grid>
 </Border>
 </Grid>

 <!-- ===== PHẢI: KẾT QUẢ NESTING + CHI TIẾT TẤM ===== -->
 <Grid Grid.Column="4">
 <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="140"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Grid.Row="0" Style="{StaticResource CardFlat}" Padding="12,10" Margin="0,0,0,12">
 <Grid>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <DockPanel Grid.Row="0" Margin="4,2,4,10" LastChildFill="False">
 <TextBlock Text="Kết quả Nesting" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
 <TextBlock DockPanel.Dock="Right" Text="{Binding Sheets.Count, StringFormat='{}{0} tấm'}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
 </DockPanel>
 <ListBox Grid.Row="1" ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
 <ListBox.ContextMenu>
 <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
 <MenuItem Header="Thêm tấm thủ công" Command="{Binding AddManualSheetCommand}"/>
 <Separator/>
 <MenuItem Header="Xóa nesting tấm đang chọn" Command="{Binding DeleteSelectedSheetCommand}"/>
 <MenuItem Header="Xóa toàn bộ kết quả nesting…" Click="ClearNesting_Click"/>
 </ContextMenu>
 </ListBox.ContextMenu>
 <ListBox.ItemContainerStyle>
 <Style TargetType="ListBoxItem">
 <Setter Property="Padding" Value="0"/>
 <Setter Property="Margin" Value="0,0,0,8"/>
 <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
 <Setter Property="Template">
 <Setter.Value>
 <ControlTemplate TargetType="ListBoxItem">
 <Border x:Name="Card" Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10"><ContentPresenter/></Border>
 <ControlTemplate.Triggers>
 <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/></Trigger>
 <Trigger Property="IsSelected" Value="True">
 <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
 <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentTintAltBrush}"/>
 <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
 </Trigger>
 </ControlTemplate.Triggers>
 </ControlTemplate>
 </Setter.Value>
 </Setter>
 </Style>
 </ListBox.ItemContainerStyle>
 <ListBox.ItemTemplate>
 <DataTemplate>
 <Grid Margin="10">
 <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="{DynamicResource ThumbBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0" Height="68">
 <local:SheetThumbnailView Sheet="{Binding Sheet}"/>
 </Border>
 <StackPanel Grid.Column="1" VerticalAlignment="Center">
 <DockPanel LastChildFill="False">
 <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"><Run Text="Tấm "/><Run Text="{Binding Sheet.Index, Mode=OneWay}"/></TextBlock>
 <TextBlock DockPanel.Dock="Right" Text="{Binding Sheet.Utilization, StringFormat='{}{0:P1}'}" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
 </DockPanel>
 <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" FontSize="12.5"><Run Text="{Binding Material, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Thickness, Mode=OneWay, StringFormat='{}{0:0.###}'}"/><Run Text=" mm"/></TextBlock>
 <ProgressBar Value="{Binding Sheet.Utilization, Mode=OneWay}" Maximum="1" Height="6" Margin="0,7,0,4" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource ProgressTrackBrush}" BorderThickness="0"/>
 <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12"><Run Text="{Binding Sheet.Placements.Count, Mode=OneWay}"/><Run Text=" chi tiết"/></TextBlock>
 </StackPanel>
 </Grid>
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 </Grid>
 </Border>

 <Border Grid.Row="1" Style="{StaticResource CardFlat}" Padding="16,12">
 <StackPanel>
 <TextBlock Text="Chi tiết tấm" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
 <Grid Margin="0,0,0,0" MinHeight="34"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Tên tấm" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding SelectedSheet.Sheet.Index, Mode=OneWay, StringFormat='Tấm {}{0}', TargetNullValue='—', FallbackValue='—'}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid><Border Height="1" Background="{DynamicResource AppBorderBrush}" Opacity="0.7"/>
 <Grid Margin="0,0,0,0" MinHeight="34"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Vật liệu" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding SelectedSheet.Material, Mode=OneWay, TargetNullValue='—', FallbackValue='—'}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid><Border Height="1" Background="{DynamicResource AppBorderBrush}" Opacity="0.7"/>
 <Grid Margin="0,0,0,0" MinHeight="34"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Độ dày" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding SelectedSheet.Thickness, Mode=OneWay, StringFormat='{}{0:0.###} mm', TargetNullValue='—', FallbackValue='—'}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid><Border Height="1" Background="{DynamicResource AppBorderBrush}" Opacity="0.7"/>
 <Grid Margin="0,0,0,0" MinHeight="34"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Kích thước" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"><Run Text="{Binding SelectedSheet.Sheet.Width, Mode=OneWay, StringFormat='{}{0:0}'}"/><Run Text=" × "/><Run Text="{Binding SelectedSheet.Sheet.Height, Mode=OneWay, StringFormat='{}{0:0}'}"/><Run Text=" mm"/></TextBlock></Grid><Border Height="1" Background="{DynamicResource AppBorderBrush}" Opacity="0.7"/>
 <Grid Margin="0,0,0,0" MinHeight="34"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Số chi tiết" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding SelectedSheet.Sheet.Placements.Count, Mode=OneWay, TargetNullValue='—', FallbackValue='—'}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid><Border Height="1" Background="{DynamicResource AppBorderBrush}" Opacity="0.7"/>
 <Grid Margin="0,0,0,0" MinHeight="34"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Diện tích sử dụng" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding SelectedSheet.Sheet.Utilization, Mode=OneWay, StringFormat='{}{0:P1}', TargetNullValue='—', FallbackValue='—'}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid><Border Height="1" Background="{DynamicResource AppBorderBrush}" Opacity="0.7"/>
 </StackPanel>
 </Border>
 </Grid>
 </Grid>
 </Grid>
 </TabItem>
            <TabItem Header="Export">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="1000" HorizontalAlignment="Left"><TextBlock Text="Xuất kết quả" Style="{StaticResource SectionTitle}"/><TextBlock Text="Chọn định dạng phù hợp để lưu bố trí nesting và báo cáo." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,18"/>
                    <UniformGrid Columns="2">
                        
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="BẢN VẼ" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock Text="DXF" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,7,0,5"/><TextBlock Text="Chọn layer, hướng nest, đơn vị, phiên bản DXF, blocks và cách xuất nhiều tấm." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" MinHeight="52"/><Button Content="Thiết lập / Xuất DXF..." Click="ExportDxf_Click" Margin="0,12,0,0" HorizontalAlignment="Left" IsEnabled="{Binding IsIdle}"/></StackPanel></Border>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="BÁO CÁO IN" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock Text="PDF" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,7,0,5"/><TextBlock Text="Xem trước từng trang báo cáo, duyệt bảng/ID rồi lưu PDF trực tiếp (không cần máy in PDF)." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" MinHeight="52"/><Button Content="Xem trước / Xuất PDF..." Click="PreviewReport_Click" Margin="0,12,0,0" HorizontalAlignment="Left" IsEnabled="{Binding IsIdle}"/></StackPanel></Border>
                    </UniformGrid>
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,16,0,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Tóm tắt kết quả hiện tại" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding Summary, TargetNullValue=Chưa chạy nesting}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0"/></StackPanel><ListBox ItemsSource="{Binding Messages}" BorderThickness="0" Background="Transparent" MaxHeight="180" Margin="0,12,0,0"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Thiết lập">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="920" HorizontalAlignment="Left">
                        <TextBlock Text="Thiết lập" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Cấu hình khoảng cách và cách thuật toán tìm phương án nesting." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,18"/>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Thuật toán nesting" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <CheckBox Content="Cho phép tự động xoay chi tiết" IsChecked="{Binding Settings.AllowRotation, Mode=TwoWay}" Margin="2,4,2,12" ToolTip="Cho phép thuật toán xoay part theo bước xoay bên dưới."/>
                                <TextBlock Text="Hướng lấp đầy" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{x:Static ui:NestSettings.Directions}" DisplayMemberPath="Text" SelectedValuePath="Direction" SelectedValue="{Binding Settings.Direction, Mode=TwoWay}" Padding="7,5" Margin="0,0,0,10"/>
                                <TextBlock Text="Bước xoay chi tiết (độ)" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{x:Static ui:NestSettings.RotationSteps}" SelectedItem="{Binding Settings.RotationStep, Mode=TwoWay}" Padding="7,5" Margin="0,0,0,10"/>
                                <TextBlock Text="Giới hạn thời gian nesting (giây)" Style="{StaticResource Label}"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding Settings.MaxSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/>
                                <TextBlock Text="Mục tiêu hiệu suất (%)" Style="{StaticResource Label}"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding Settings.TargetUtilizationPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4"/>
                                <TextBlock Text="Đặt mục tiêu hiệu suất bằng 0 để tắt dừng sớm theo mục tiêu; giới hạn thời gian vẫn luôn có hiệu lực." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,14"/>
                                <Separator Margin="0,2,0,12"/>
                                <TextBlock Text="Khoảng cách an toàn (mm)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Lề từ chi tiết đến mép tấm" Style="{StaticResource Label}"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding Settings.Margin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/>
                                <TextBlock Text="Khoảng cách giữa các chi tiết" Style="{StaticResource Label}"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding Settings.Spacing, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Thông tin">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="920" HorizontalAlignment="Left">
                        <TextBlock Text="Thông tin Cyclone Nest2D" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Ứng dụng nesting chi tiết 2D cho tấm kim loại." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,18"/>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Cyclone Nest2D" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock x:Name="AboutVersion" Text="Phiên bản 1.0.0" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                                <TextBlock Text="Tác giả: Phạm Đức Duy" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Hướng dẫn nhanh" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="• Thêm DXF ASCII tại trang Part hoặc kéo file vào cửa sổ.&#10;• Gán vật liệu, độ dày và khổ tấm tại Part/Sheets.&#10;• Nhấn F5 để nesting; dùng Dừng để hủy tác vụ đang chạy.&#10;• Tại trang Nesting: lăn chuột để zoom, kéo nền để pan, kéo chi tiết để chỉnh vị trí.&#10;• Chọn chi tiết rồi dùng mũi tên để đẩy tới vật cản/mép tấm; Shift + mũi tên dịch 1 mm. R xoay, M lật, Delete xóa placement.&#10;• Lưu dự án .nest2d để giữ danh sách Part, thiết lập và tham chiếu DXF. Xuất DXF/PDF tại trang Export."
                                           TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Kiểm tra contour và DXF đầu ra bằng phần mềm CAD/CAM đích trước khi sản xuất."
                                   Foreground="{DynamicResource WarningBadgeTextBrush}" TextWrapping="Wrap" Margin="2,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
 </TabControl>
                <!-- Busy overlay -->
<Border Panel.ZIndex="100" Background="{DynamicResource OverlayBgBrush}" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="26" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22" Color="#10243F"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="ĐANG NESTING" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Ứng dụng đang thử bố trí theo từng vật liệu, độ dày và khổ tấm." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,14" TextWrapping="Wrap"/>
                    <ProgressBar IsIndeterminate="True" Height="8" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource ProgressTrackBrush}" BorderThickness="0"/>
                    <TextBlock Text="{Binding Progress, TargetNullValue=Đang khởi tạo...}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,2" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    <Button Content="Dừng nesting" Command="{Binding CancelCommand}" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="14,7" Foreground="{DynamicResource DangerTextBrush}"/>
                </StackPanel>
            </Border>
        </Border>
 </Grid>
 </Grid>

 <!-- ================= THANH TRẠNG THÁI ================= -->
 <Border Grid.Row="2" Background="{DynamicResource TopBarBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
 <Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
 <Grid Width="22" Height="22" Margin="0,0,10,0"><Ellipse Fill="{DynamicResource SuccessBrush}"/><Path Data="{StaticResource IcCheck}" Style="{StaticResource Ico}" Width="12" Height="12" StrokeThickness="2.6" Stroke="White"/></Grid>
 <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"><Run Text="{Binding PlacedCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding RequiredCount, Mode=OneWay}"/><Run Text=" chi tiết đã xếp"/></TextBlock>
 <ProgressBar Width="200" Height="8" Margin="14,0,0,0" Maximum="{Binding RequiredCount, Mode=OneWay}" Value="{Binding PlacedCount, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}" Background="{DynamicResource ProgressTrackBrush}" BorderThickness="0" VerticalAlignment="Center"/>
 </StackPanel>
 <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,12,0">
 <StackPanel.Style>
 <Style TargetType="StackPanel">
 <Style.Triggers>
 <DataTrigger Binding="{Binding Result}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
 <DataTrigger Binding="{Binding RemainingCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
 </Style.Triggers>
 </Style>
 </StackPanel.Style>
 <Border Background="{DynamicResource WarningBadgeBgBrush}" BorderBrush="{DynamicResource WarningBadgeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,5">
 <StackPanel Orientation="Horizontal">
 <Path Data="{StaticResource IcWarn}" Style="{StaticResource Ico}" Width="15" Height="15" Stroke="{DynamicResource WarningBadgeTextBrush}" Margin="0,0,8,0"/>
 <TextBlock Foreground="{DynamicResource WarningBadgeTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="Còn "/><Run Text="{Binding RemainingCount, Mode=OneWay}"/><Run Text=" chi tiết chưa được xếp. Kiểm tra kích thước tấm hoặc đổi tham số."/></TextBlock>
 </StackPanel>
 </Border>
 </StackPanel>
 <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
 <TextBlock Text="Tấm:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,5,0"/>
 <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="{Binding SelectedSheet.Sheet.Width, Mode=OneWay, StringFormat='{}{0:0}'}"/><Run Text=" × "/><Run Text="{Binding SelectedSheet.Sheet.Height, Mode=OneWay, StringFormat='{}{0:0}'}"/><Run Text=" mm"/></TextBlock>
 <Border Width="1" Height="16" Background="{DynamicResource AppBorderBrush}" Margin="12,0"/>
 <TextBlock Text="Vật liệu:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,5,0"/>
 <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="{Binding SelectedSheet.Material, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedSheet.Thickness, Mode=OneWay, StringFormat='{}{0:0.###}'}"/><Run Text=" mm"/></TextBlock>
 <Border Width="1" Height="16" Background="{DynamicResource AppBorderBrush}" Margin="12,0"/>
 <TextBlock Text="Hiển thị:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,5,0"/>
 <TextBlock x:Name="FooterZoom" Text="Fit" Foreground="{DynamicResource TextSecondaryBrush}"/>
 </StackPanel>
 </Grid>
 </Border>

<ItemsControl ItemsSource="{Binding Toasts.Items}" Grid.RowSpan="4" Panel.ZIndex="110" HorizontalAlignment="Right" VerticalAlignment="Top" Width="350" Margin="0,68,16,0" Focusable="False">
            <ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,6,0,0" SnapsToDevicePixels="True">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" Color="#10243F"/></Border.Effect>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{Binding AccentHex, Mode=OneWay}" CornerRadius="8,0,0,8"/>
                        <Border Grid.Column="1" Width="30" Height="30" CornerRadius="15" Background="{Binding TintHex, Mode=OneWay}" Margin="10,10,0,10" VerticalAlignment="Top">
                            <Path Data="{Binding IconData, Mode=OneWay}" Stroke="{Binding AccentHex, Mode=OneWay}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" Margin="10,9,6,10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Text, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="3" Command="{Binding DismissCommand}" Width="24" Height="24" Padding="0" Margin="0,6,6,0" VerticalAlignment="Top" Background="Transparent" BorderBrush="Transparent" ToolTip="Đóng"><Path Data="{StaticResource IcClose}" Style="{StaticResource Ico}" Width="10" Height="10"/></Button>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
 </Grid>
</Window>
