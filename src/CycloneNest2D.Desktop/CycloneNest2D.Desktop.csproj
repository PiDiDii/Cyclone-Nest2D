<Project Sdk="Microsoft.NET.Sdk">

  <!-- Chỉ build được trên Windows (cần .NET 8 SDK + workload Windows Desktop, có sẵn trong bộ cài .NET SDK cho Windows). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CycloneNest2D</AssemblyName>
    <Product>Cyclone Nest2D</Product>
    <Version>1.0.11</Version>
    <AssemblyInformationalVersion>1.0.11 - Cập nhật 31/10/2026</AssemblyInformationalVersion>
    <Authors>Phạm Đức Duy</Authors>
    <RootNamespace>CycloneNest2D.Desktop</RootNamespace>
    <ApplicationIcon>Assets\CycloneNest.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\CycloneNest.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CycloneNest2D.UI.Core\CycloneNest2D.UI.Core.csproj" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
  </ItemGroup>

</Project>
