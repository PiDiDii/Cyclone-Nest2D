<Application x:Class="CycloneNest2D.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            </Style>

            <BooleanToVisibilityConverter x:Key="B2V" />

            <!-- Icon vector: lưới 24x24. Stroke/Fill mặc định theo theme; dùng brush ngữ nghĩa khi cần tương phản trên nền màu. -->
            <Style x:Key="Ico" TargetType="Path">
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="StrokeThickness" Value="1.8" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="False" />
                <Setter Property="Stroke" Value="{DynamicResource IconStrokeBrush}" />
            </Style>
            <Style x:Key="IcoSolid" TargetType="Path" BasedOn="{StaticResource Ico}">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="Fill" Value="{DynamicResource IconFillBrush}" />
            </Style>

            <Geometry x:Key="IcFile">M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19</Geometry>
            <Geometry x:Key="IcPart">M4,8 L10,4 L20,9 L18,19 L7,20 Z M10,12 A2,2 0 1 1 14,12 A2,2 0 1 1 10,12</Geometry>
            <Geometry x:Key="IcSheets">M3,4 H21 V20 H3 Z M3,12 H21 M12,4 V20</Geometry>
            <Geometry x:Key="IcNesting">M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z</Geometry>
            <Geometry x:Key="IcExport">M12,15 V3 M7,8 L12,3 L17,8 M4,15 V20 H20 V15</Geometry>
            <Geometry x:Key="IcPlay">M7,4 L19,12 L7,20 Z</Geometry>
            <Geometry x:Key="IcSettings">M4,7 H20 M4,17 H20 M9,4 V10 M15,14 V20</Geometry>
            <Geometry x:Key="IcInfo">M12,3 A9,9 0 1 1 12,21 A9,9 0 1 1 12,3 Z M12,11 V17 M12,7 V7.2</Geometry>
            <Geometry x:Key="IcMin">M5,19 H19</Geometry>
            <Geometry x:Key="IcMax">M5,5 H19 V19 H5 Z</Geometry>
            <Geometry x:Key="IcClose">M5,5 L19,19 M19,5 L5,19</Geometry>
            <Geometry x:Key="IcSelect">M5,3 V19 L9.5,15 L12.5,21 L15,20 L12,14 L18,14 Z</Geometry>
            <Geometry x:Key="IcPan">M12,3 V21 M3,12 H21 M12,3 L9,6 M12,3 L15,6 M12,21 L9,18 M12,21 L15,18 M3,12 L6,9 M3,12 L6,15 M21,12 L18,9 M21,12 L18,15</Geometry>
            <Geometry x:Key="IcZoomBox">M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15 M9,9 H15 V15 H9 Z</Geometry>
            <Geometry x:Key="IcFit">M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15</Geometry>
            <Geometry x:Key="IcPlus">M12,5 V19 M5,12 H19</Geometry>
            <Geometry x:Key="IcMinus">M5,12 H19</Geometry>
            <Geometry x:Key="IcPrev">M15,5 L8,12 L15,19</Geometry>
            <Geometry x:Key="IcNext">M9,5 L16,12 L9,19</Geometry>
            <Geometry x:Key="IcCheck">M5,12.5 L10,17.5 L19,7</Geometry>
            <Geometry x:Key="IcWarn">M12,4 L21,20 H3 Z M12,10 V14 M12,17 V17.5</Geometry>
            <Geometry x:Key="IcHome">M4,12 L12,4 L20,12 V20 H14 V14 H10 V20 H4 Z</Geometry>
            <Geometry x:Key="IcSun">M12,8 A4,4 0 1 1 12,16 A4,4 0 1 1 12,8 Z M12,2 V4 M12,20 V22 M2,12 H4 M20,12 H22 M4.9,4.9 L6.3,6.3 M17.7,17.7 L19.1,19.1 M4.9,19.1 L6.3,17.7 M17.7,6.3 L19.1,4.9</Geometry>
            <Geometry x:Key="IcMoon">M20,14.5 A8.5,8.5 0 1 1 9.5,4 A6.5,6.5 0 0 0 20,14.5 Z</Geometry>
            <Geometry x:Key="IcSave">M5,4 H16 L20,8 V20 H5 Z M8,4 V9 H15 V4 M8,20 V14 H16 V20</Geometry>
            <Geometry x:Key="IcNewProject">M6,3 H14 L19,8 V13 M14,3 V8 H19 M12,14 V22 M8,18 H16</Geometry>
            <Geometry x:Key="IcOpenProject">M3,7 H9 L11,9 H21 V20 H3 Z M3,10 H21</Geometry>
            <Geometry x:Key="IcEye">M2.5,12 C5,7.5 8,5.5 12,5.5 C16,5.5 19,7.5 21.5,12 C19,16.5 16,18.5 12,18.5 C8,18.5 5,16.5 2.5,12 Z M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12</Geometry>
            <Geometry x:Key="IcHelp">M12,3 A9,9 0 1 1 12,21 A9,9 0 1 1 12,3 Z M9.5,9.5 A2.5,2.5 0 1 1 12,12 V13.5 M12,17 V17.2</Geometry>
            <Geometry x:Key="IcStop">M6,6 H18 V18 H6 Z</Geometry>
            <Geometry x:Key="IcTrash">M4,7 H20 M9,7 V4 H15 V7 M6,7 L7,20 H17 L18,7 M10,11 V16 M14,11 V16</Geometry>
            <Geometry x:Key="IcImportPart">M5,3 H13 L18,8 V21 H5 Z M13,3 V8 H18 M12,11 V17 M9,14.5 L12,17.5 L15,14.5</Geometry>
            <Geometry x:Key="IcImportSheet">M3,5 H21 V19 H3 Z M3,9 H21 M12,11.5 V16.5 M9.5,14 L12,16.5 L14.5,14</Geometry>
            <Geometry x:Key="IcRotate">M20,12 A8,8 0 1 1 17.7,6.3 M20,4 V9 H15</Geometry>
            <Geometry x:Key="IcGap">M4,5 V19 M20,5 V19 M8,12 H16 M8,12 L10.5,9.5 M8,12 L10.5,14.5 M16,12 L13.5,9.5 M16,12 L13.5,14.5</Geometry>
            <Geometry x:Key="IcChevDown">M6,9 L12,15 L18,9</Geometry>
            <Geometry x:Key="IcChevUp">M6,15 L12,9 L18,15</Geometry>
            <Geometry x:Key="IcRestore">M8,8 V4 H20 V16 H16 M4,8 H16 V20 H4 Z</Geometry>
            <Geometry x:Key="IcFolderOpen">M3,6 H9 L11,8 H21 V19 H3 Z</Geometry>
            <Geometry x:Key="IcMenu">M4,7 H20 M4,12 H20 M4,17 H20</Geometry>
            <!-- Icon trên sidebar: đổi sang màu chính khi mục được chọn -->
            <Style x:Key="NavIco" TargetType="Path" BasedOn="{StaticResource Ico}">
                <Setter Property="StrokeThickness" Value="1.9"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                        <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
