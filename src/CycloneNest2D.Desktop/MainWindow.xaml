                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{Binding AccentHex, Mode=OneWay}" CornerRadius="8,0,0,8"/>
                        <Border Grid.Column="1" Width="30" Height="30" CornerRadius="15" Background="{Binding TintHex, Mode=OneWay}" Margin="10,10,0,10" VerticalAlignment="Top">
                            <Path Data="{Binding IconData, Mode=OneWay}" Stroke="{Binding AccentHex, Mode=OneWay}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" Margin="10,9,6,10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Text, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="3" Command="{Binding DismissCommand}" Width="24" Height="24" Padding="0" Margin="0,6,6,0" VerticalAlignment="Top" Background="Transparent" BorderBrush="Transparent" ToolTip="Đóng"><Path Data="{StaticResource IcClose}" Style="{StaticResource Ico}" Width="10" Height="10"/></Button>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
 </Grid>
