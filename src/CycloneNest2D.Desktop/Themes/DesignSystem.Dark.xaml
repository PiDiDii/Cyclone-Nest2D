<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ========== COLOR TOKENS (Dark Theme) ========== -->
  <Color x:Key="PrimaryColor">#22C0CC</Color>
  <Color x:Key="PrimaryDarkColor">#69D8E0</Color>
  <Color x:Key="PrimaryLightColor">#8AE8ED</Color>
  <Color x:Key="AccentColor">#76A9FA</Color>
  <Color x:Key="BgColor">#0C131B</Color>
  <Color x:Key="SurfaceColor">#131E29</Color>
  <Color x:Key="BorderColor">#2A3B4D</Color>
  <Color x:Key="BorderHoverColor">#3B5268</Color>
  <Color x:Key="TextPrimaryColor">#E9F0F7</Color>
  <Color x:Key="TextSecondaryColor">#B1BFCE</Color>
  <Color x:Key="TextMutedColor">#91A2B5</Color>
  <Color x:Key="SidebarBgColor">#101923</Color>
  <Color x:Key="SidebarActiveBgColor">#10333B</Color>
  <Color x:Key="DangerColor">#F87171</Color>
  <Color x:Key="SuccessColor">#4ADE9A</Color>
  <Color x:Key="WarningColor">#FBBF24</Color>

  <!-- Core semantic brushes -->
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
  <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
  <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="#062B30"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
  <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
  <SolidColorBrush x:Key="SidebarActiveBgBrush" Color="{StaticResource SidebarActiveBgColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

  <!-- Extended UI state brushes (Dark overrides) -->
  <SolidColorBrush x:Key="IconStrokeBrush" Color="#B8C7D6"/>
  <SolidColorBrush x:Key="IconFillBrush" Color="#B8C7D6"/>
  <SolidColorBrush x:Key="CardBgBrush" Color="#131E29"/>
  <SolidColorBrush x:Key="CardBgAltBrush" Color="#101A24"/>
  <SolidColorBrush x:Key="CardBgHoverBrush" Color="#1B2B3A"/>
  <SolidColorBrush x:Key="PartListBorderBrush" Color="#3D5267"/>
  <SolidColorBrush x:Key="PartSelectionBgBrush" Color="#087F8C"/>
  <SolidColorBrush x:Key="PartSelectionTextBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PartSelectionBorderBrush" Color="#4DD0D8"/>
  <SolidColorBrush x:Key="AccentTintBrush" Color="#10333B"/>
  <SolidColorBrush x:Key="AccentTintAltBrush" Color="#0E2830"/>
  <SolidColorBrush x:Key="WindowBtnHoverBrush" Color="#1E3042"/>
  <SolidColorBrush x:Key="WindowBtnPressedBrush" Color="#2D4A5E"/>
  <SolidColorBrush x:Key="OverlayBgBrush" Color="#D90A121A"/>
  <SolidColorBrush x:Key="OverlayCardBrush" Color="#192735"/>
  <SolidColorBrush x:Key="FieldBgBrush" Color="#0D1721"/>
  <SolidColorBrush x:Key="ProgressTrackBrush" Color="#24364A"/>
  <SolidColorBrush x:Key="WarningBadgeBgBrush" Color="#422D08"/>
  <SolidColorBrush x:Key="WarningBadgeBorderBrush" Color="#75520E"/>
  <SolidColorBrush x:Key="WarningBadgeTextBrush" Color="#FFD66B"/>
  <SolidColorBrush x:Key="StaleBadgeBgBrush" Color="#422D08"/>
  <SolidColorBrush x:Key="StaleBadgeTextBrush" Color="#FFD66B"/>
  <SolidColorBrush x:Key="DangerBtnBgBrush" Color="#3C1517"/>
  <SolidColorBrush x:Key="DangerBtnBorderBrush" Color="#743033"/>
  <SolidColorBrush x:Key="DangerTextBrush" Color="#FFAAAA"/>
  <SolidColorBrush x:Key="CanvasGridMinorBrush" Color="#08FFFFFF"/>
  <SolidColorBrush x:Key="CanvasGridMajorBrush" Color="#12FFFFFF"/>


  <!-- ===== Token bổ sung: thanh trên, thanh công cụ, canvas ===== -->
  <SolidColorBrush x:Key="TopBarBgBrush" Color="#101923"/>
  <SolidColorBrush x:Key="ToolbarBgBrush" Color="#111C26"/>
  <SolidColorBrush x:Key="CanvasBgBrush" Color="#0C141D"/>
  <SolidColorBrush x:Key="SheetFillBrush" Color="#131E29"/>
  <SolidColorBrush x:Key="SheetBorderBrush" Color="#D8E5EF"/>
  <SolidColorBrush x:Key="PartOutlineBrush" Color="#D1E6EA"/>
  <SolidColorBrush x:Key="CanvasTextBrush" Color="#CFD8E3"/>
  <SolidColorBrush x:Key="ThumbBgBrush" Color="#0D1721"/>

</ResourceDictionary>
