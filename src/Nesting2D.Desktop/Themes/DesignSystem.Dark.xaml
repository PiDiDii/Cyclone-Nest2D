<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ========== COLOR TOKENS (Dark Theme) ========== -->
  <Color x:Key="PrimaryColor">#19B3C0</Color>
  <Color x:Key="PrimaryDarkColor">#4CD3DE</Color>
  <Color x:Key="PrimaryLightColor">#7BE4EC</Color>
  <Color x:Key="AccentColor">#5B9BFF</Color>
  <Color x:Key="BgColor">#0A121A</Color>
  <Color x:Key="SurfaceColor">#111C27</Color>
  <Color x:Key="BorderColor">#213447</Color>
  <Color x:Key="BorderHoverColor">#33506A</Color>
  <Color x:Key="TextPrimaryColor">#EAF1F8</Color>
  <Color x:Key="TextSecondaryColor">#A7B6C8</Color>
  <Color x:Key="TextMutedColor">#7A8CA2</Color>
  <Color x:Key="SidebarBgColor">#0C1520</Color>
  <Color x:Key="SidebarActiveBgColor">#0E3A44</Color>
  <Color x:Key="DangerColor">#F87171</Color>
  <Color x:Key="SuccessColor">#34D399</Color>
  <Color x:Key="WarningColor">#FBBF24</Color>

  <!-- Core semantic brushes -->
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
  <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
  <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
  <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
  <SolidColorBrush x:Key="SidebarActiveBgBrush" Color="{StaticResource SidebarActiveBgColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

  <!-- Extended UI state brushes (Dark overrides) -->
  <SolidColorBrush x:Key="IconStrokeBrush" Color="#B4C3D4"/>
  <SolidColorBrush x:Key="IconFillBrush" Color="#B4C3D4"/>
  <SolidColorBrush x:Key="CardBgBrush" Color="#111C27"/>
  <SolidColorBrush x:Key="CardBgAltBrush" Color="#0E1822"/>
  <SolidColorBrush x:Key="CardBgHoverBrush" Color="#172636"/>
  <SolidColorBrush x:Key="AccentTintBrush" Color="#0E3A44"/>
  <SolidColorBrush x:Key="AccentTintAltBrush" Color="#0C2D36"/>
  <SolidColorBrush x:Key="WindowBtnHoverBrush" Color="#1E3042"/>
  <SolidColorBrush x:Key="WindowBtnPressedBrush" Color="#2D4A5E"/>
  <SolidColorBrush x:Key="OverlayBgBrush" Color="#CC0A1018"/>
  <SolidColorBrush x:Key="OverlayCardBrush" Color="#1A2836"/>
  <SolidColorBrush x:Key="FieldBgBrush" Color="#0E151D"/>
  <SolidColorBrush x:Key="ProgressTrackBrush" Color="#1E3042"/>
  <SolidColorBrush x:Key="WarningBadgeBgBrush" Color="#422006"/>
  <SolidColorBrush x:Key="WarningBadgeBorderBrush" Color="#854D0E"/>
  <SolidColorBrush x:Key="WarningBadgeTextBrush" Color="#FBBF24"/>
  <SolidColorBrush x:Key="StaleBadgeBgBrush" Color="#422006"/>
  <SolidColorBrush x:Key="StaleBadgeTextBrush" Color="#FBBF24"/>
  <SolidColorBrush x:Key="DangerBtnBgBrush" Color="#450A0A"/>
  <SolidColorBrush x:Key="DangerBtnBorderBrush" Color="#991B1B"/>
  <SolidColorBrush x:Key="DangerTextBrush" Color="#FCA5A5"/>
  <SolidColorBrush x:Key="CanvasGridMinorBrush" Color="#08FFFFFF"/>
  <SolidColorBrush x:Key="CanvasGridMajorBrush" Color="#12FFFFFF"/>


  <!-- ===== Token bổ sung: thanh trên, thanh công cụ, canvas ===== -->
  <SolidColorBrush x:Key="TopBarBgBrush" Color="#0D1620"/>
  <SolidColorBrush x:Key="ToolbarBgBrush" Color="#0F1924"/>
  <SolidColorBrush x:Key="CanvasBgBrush" Color="#09121A"/>
  <SolidColorBrush x:Key="SheetFillBrush" Color="#0F1B27"/>
  <SolidColorBrush x:Key="SheetBorderBrush" Color="#E2EAF2"/>
  <SolidColorBrush x:Key="PartOutlineBrush" Color="#C7EEF2"/>
  <SolidColorBrush x:Key="CanvasTextBrush" Color="#CBD5E1"/>
  <SolidColorBrush x:Key="ThumbBgBrush" Color="#0B1620"/>

</ResourceDictionary>
