<Project Sdk="Microsoft.NET.Sdk">

  <!-- Chỉ build được trên Windows (cần .NET 8 SDK + workload Windows Desktop, có sẵn trong bộ cài .NET SDK cho Windows). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Nesting2D</AssemblyName>
    <RootNamespace>Nesting2D.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nesting2D.UI.Core\Nesting2D.UI.Core.csproj" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
  </ItemGroup>

</Project>

