<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CycloneNest2D.UI;assembly=CycloneNest2D.UI.Core"
        xmlns:local="clr-namespace:CycloneNest2D.Desktop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Class="CycloneNest2D.Desktop.MainWindow"
        Title="{Binding Title}"
        Width="1560" Height="900" MinWidth="1100" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" FontFamily="{StaticResource AppFont}" FontSize="13.5"
 Foreground="{DynamicResource TextPrimaryBrush}" StateChanged="Window_StateChanged"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveProjectCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding AddDxfCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate x:Key="LayerTemplate"><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="3,2"><TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Note, Mode=OneWay}" Foreground="Gray"/></TextBlock></CheckBox></DataTemplate>
    <Style x:Key="PartTableHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernTableHeader}">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PartListBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style x:Key="CloseGlyph" TargetType="Path">
 <Setter Property="Stroke" Value="{DynamicResource IconStrokeBrush}"/>
 <Style.Triggers>
 <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
 <Setter Property="Stroke" Value="White"/>
 </DataTrigger>
 </Style.Triggers>
 </Style>
 </Window.Resources>


 <!-- ROOT: thanh trên / thanh công cụ / (sidebar + nội dung) / thanh trạng thái -->
 <Grid x:Name="RootLayout">
 <Grid.RowDefinitions>
 <RowDefinition Height="56"/>
 <RowDefinition Height="*"/>
 <RowDefinition Height="40"/>
 </Grid.RowDefinitions>

 <Popup x:Name="ShortcutOverlayPopup" Placement="Center" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False" IsOpen="False">
  <Border Background="{DynamicResource OverlayCardBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24,18" Width="420">
   <StackPanel>
    <TextBlock Text="Phím tắt" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
    <TextBlock x:Name="ShortcutOverlayText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
 </Popup>

 <!-- ================= THANH TRÊN ================= -->
 <Border Grid.Row="0" Background="{DynamicResource TopBarBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
 <Grid>
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
 </Grid.ColumnDefinitions>

 <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,16,0">
 <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource PrimaryBrush}" Margin="0,0,11,0">
 <Path Data="{StaticResource IcNesting}" Style="{StaticResource Ico}" Stroke="{DynamicResource OnPrimaryBrush}" Width="18" Height="18"/>
 </Border>
 <TextBlock Text="CYCLONE NEST2D" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
 </StackPanel>

 <Border Grid.Column="1" Background="{DynamicResource AccentTintBrush}" BorderBrush="{DynamicResource PrimaryLightBrush}" BorderThickness="1" CornerRadius="8" Padding="9,5" VerticalAlignment="Center" ToolTip="{Binding ProjectPath, TargetNullValue='Dự án hiện tại'}">
 <StackPanel Orientation="Horizontal">
 <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource PrimaryBrush}" Margin="0,0,8,0">
 <Path Data="{StaticResource IcFolderOpen}" Style="{StaticResource Ico}" Stroke="{DynamicResource OnPrimaryBrush}" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
 </Border>
 <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="210" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
 <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" Margin="8,0,0,0" ToolTip="Có thay đổi chưa lưu trong dự án" Visibility="{Binding IsProjectDirty, Converter={StaticResource B2V}}"/>
 </StackPanel>
 </Border>

 <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,12,0">
 <Button Style="{StaticResource ToolbarButton}" Command="{Binding NewProjectCommand}" Padding="5" Margin="0,0,3,0" ToolTip="Dự án mới" AutomationProperties.Name="Dự án mới" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Border Background="{DynamicResource AccentTintBrush}" CornerRadius="6" Padding="5"><Path Data="{StaticResource IcNewProject}" Style="{StaticResource Ico}" Stroke="{DynamicResource PrimaryDarkBrush}" Width="18" Height="18"/></Border></Button>
 <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenProjectCommand}" Padding="5" Margin="0,0,3,0" ToolTip="Mở dự án" AutomationProperties.Name="Mở dự án" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Border Background="{DynamicResource AccentTintBrush}" CornerRadius="6" Padding="5"><Path Data="{StaticResource IcOpenProject}" Style="{StaticResource Ico}" Stroke="{DynamicResource PrimaryDarkBrush}" Width="18" Height="18"/></Border></Button>
 <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveProjectCommand}" Padding="5" Margin="0,0,10,0" ToolTip="Lưu dự án" AutomationProperties.Name="Lưu dự án" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Border Background="{DynamicResource AccentTintBrush}" CornerRadius="6" Padding="5"><Path Data="{StaticResource IcSave}" Style="{StaticResource Ico}" Stroke="{DynamicResource PrimaryDarkBrush}" Width="18" Height="18"/></Border></Button>
 <TextBlock Text="Nhóm:" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
 <ComboBox ItemsSource="{Binding ProjectGroups}" SelectedItem="{Binding SelectedProjectGroup, Mode=TwoWay}" DisplayMemberPath="Name" Width="210" ToolTip="Chuyển nhóm vật liệu" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
 </StackPanel>

 <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
 <Button x:Name="ThemeButton" Style="{StaticResource WindowButton}" Click="ToggleTheme_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Đổi giao diện Sáng / Tối" AutomationProperties.Name="Chuyển giao diện" Width="44">
 <Path x:Name="ThemeIcon" Data="{StaticResource IcSun}" Style="{StaticResource Ico}" Width="19" Height="19"/>
 </Button>
 <Button Style="{StaticResource WindowButton}" Click="ToggleShortcutOverlay_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Phím tắt" AutomationProperties.Name="Hiển thị phím tắt" Width="44">
 <Path Data="{StaticResource IcHelp}" Style="{StaticResource Ico}" Width="18" Height="18"/>
 </Button>
 <Button Style="{StaticResource WindowButton}" Click="WindowMinimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Thu nhỏ" AutomationProperties.Name="Thu nhỏ">
 <Path Data="M0,6 H12" Width="12" Height="12" Stretch="None" Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.3"/>
 </Button>
 <Button Style="{StaticResource WindowButton}" Click="WindowMaximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Phóng to / Khôi phục" AutomationProperties.Name="Phóng to hoặc khôi phục">
 <Grid Width="12" Height="12">
 <Path x:Name="MaxGlyph" Data="M0.5,0.5 H11.5 V11.5 H0.5 Z" Stretch="None" Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.3"/>
 <Path x:Name="RestoreGlyph" Data="M3,0.5 H11.5 V9 M0.5,3 H9 V11.5 H0.5 Z" Stretch="None" Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.3" Visibility="Collapsed"/>
 </Grid>
 </Button>
 <Button Style="{StaticResource WindowCloseButton}" Click="WindowClose_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Đóng" AutomationProperties.Name="Đóng" Width="50">
 <Path Data="M0,0 L12,12 M12,0 L0,12" Width="12" Height="12" Stretch="None" Style="{StaticResource CloseGlyph}" StrokeThickness="1.3"/>
 </Button>
 </StackPanel>
 </Grid>
 </Border>

 <Grid Grid.Row="1">
 <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

 <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
 <StackPanel Margin="0,10,0,0">
 <RadioButton x:Name="NavFile" Tag="0" GroupName="MainNavigation" Style="{StaticResource RailNavButton}" Click="TabNav_Click" ToolTip="Tổng quan">
 <StackPanel HorizontalAlignment="Center">
 <Path Data="{StaticResource IcHome}" Style="{StaticResource NavIco}" Width="24" Height="24"/>
 <TextBlock Text="Tổng quan" HorizontalAlignment="Center" Margin="0,6,0,0"/>
 </StackPanel>
 </RadioButton>
 <RadioButton x:Name="NavPart" Tag="1" GroupName="MainNavigation" Style="{StaticResource RailNavButton}" Click="TabNav_Click" ToolTip="Part">
 <StackPanel HorizontalAlignment="Center">
 <Path Data="{StaticResource IcPart}" Style="{StaticResource NavIco}" Width="24" Height="24"/>
 <TextBlock Text="Part" HorizontalAlignment="Center" Margin="0,6,0,0"/>
 </StackPanel>
 </RadioButton>
 <RadioButton x:Name="NavSheets" Tag="2" GroupName="MainNavigation" Style="{StaticResource RailNavButton}" Click="TabNav_Click" ToolTip="Sheets">
 <StackPanel HorizontalAlignment="Center">
 <Path Data="{StaticResource IcSheets}" Style="{StaticResource NavIco}" Width="24" Height="24"/>
 <TextBlock Text="Sheets" HorizontalAlignment="Center" Margin="0,6,0,0"/>
 </StackPanel>
 </RadioButton>
 <RadioButton x:Name="NavNesting" Tag="3" GroupName="MainNavigation" IsChecked="True" Style="{StaticResource RailNavButton}" Click="TabNav_Click" ToolTip="Nesting">
 <StackPanel HorizontalAlignment="Center">
 <Path Data="{StaticResource IcNesting}" Style="{StaticResource NavIco}" Width="24" Height="24"/>
 <TextBlock Text="Nesting" HorizontalAlignment="Center" Margin="0,6,0,0"/>
 </StackPanel>
 </RadioButton>
 <RadioButton x:Name="NavExport" Tag="4" GroupName="MainNavigation" Style="{StaticResource RailNavButton}" Click="TabNav_Click" ToolTip="Export">
 <StackPanel HorizontalAlignment="Center">
 <Path Data="{StaticResource IcExport}" Style="{StaticResource NavIco}" Width="24" Height="24"/>
 <TextBlock Text="Export" HorizontalAlignment="Center" Margin="0,6,0,0"/>
 </StackPanel>
 </RadioButton>
 <RadioButton x:Name="NavSetup" Tag="5" GroupName="MainNavigation" Style="{StaticResource RailNavButton}" Click="TabNav_Click" ToolTip="Thiết lập">
 <StackPanel HorizontalAlignment="Center">
 <Path Data="{StaticResource IcSettings}" Style="{StaticResource NavIco}" Width="24" Height="24"/>
 <TextBlock Text="Thiết lập" HorizontalAlignment="Center" Margin="0,6,0,0"/>
 </StackPanel>
 </RadioButton>
 <RadioButton x:Name="NavInfo" Tag="6" GroupName="MainNavigation" Style="{StaticResource RailNavButton}" Click="TabNav_Click" ToolTip="Thông tin">
 <StackPanel HorizontalAlignment="Center">
 <Path Data="{StaticResource IcInfo}" Style="{StaticResource NavIco}" Width="24" Height="24"/>
 <TextBlock Text="Thông tin" HorizontalAlignment="Center" Margin="0,6,0,0"/>
 </StackPanel>
 </RadioButton>
 </StackPanel>
 </Border>

 <Grid Grid.Column="1">
                <TabControl x:Name="MainTabs" SelectedIndex="3" Background="Transparent" BorderThickness="0" Padding="0" Margin="0">
            <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><TabPanel IsItemsHost="True" Visibility="Collapsed"/><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0"/></Grid></ControlTemplate></TabControl.Template>
            <TabItem Header="File">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tổng quan dự án" Style="{StaticResource SectionTitle}" FontSize="24"/>
                                <TextBlock Text="Theo dõi tiến độ và chuyển nhanh giữa các nhóm vật liệu." Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="Mở dự án..." Command="{Binding OpenProjectCommand}"/>
                                <Button Content="Dự án mới" Command="{Binding NewProjectCommand}"/>
                                <Button Content="Lưu dự án" Command="{Binding SaveProjectCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/>
                            </WrapPanel>
                        </Grid>
                        <Border Background="{DynamicResource ProjectHeroBgBrush}" CornerRadius="14" Padding="24" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ProjectName}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ProjectHeroTextBrush}"/>
                                    <TextBlock Text="{Binding ProjectPath, TargetNullValue='Chưa lưu · tạo dự án hoặc lưu để bắt đầu'}" Foreground="{DynamicResource ProjectHeroMutedBrush}" Margin="0,6,0,12" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{DynamicResource ProjectHeroChipBrush}" CornerRadius="12" Padding="10,5" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ProjectSaveState}" Foreground="{DynamicResource ProjectHeroTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ProjectHeroMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Content="Lưu thành..." Command="{Binding SaveProjectAsCommand}" Background="Transparent" BorderBrush="{DynamicResource ProjectHeroMutedBrush}" Foreground="{DynamicResource ProjectHeroTextBrush}" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <UniformGrid Columns="3" Margin="0,0,0,22">
                            <Border Style="{StaticResource CardFlat}" Padding="18" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="NHÓM VẬT LIỆU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{Binding ProjectGroupCount}" FontSize="26" FontWeight="Bold"/><TextBlock Text=" nhóm" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,4"/></StackPanel></StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardFlat}" Padding="18" Margin="5,0">
                                <StackPanel><TextBlock Text="CHI TIẾT TRONG DỰ ÁN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{Binding ProjectPartCount}" FontSize="26" FontWeight="Bold"/><TextBlock Text=" dòng" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,4"/></StackPanel></StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardFlat}" Padding="18" Margin="10,0,0,0">
                                <StackPanel><TextBlock Text="TẤM ĐÃ NESTING" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{Binding ProjectSheetCount}" FontSize="26" FontWeight="Bold"/><TextBlock Text=" tấm" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,4"/></StackPanel></StackPanel>
                            </Border>
                        </UniformGrid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Nhóm vật liệu" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Mỗi nhóm có danh sách chi tiết, khổ tấm và kết quả nesting riêng." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Nhấp chuột phải vào danh sách để tạo hoặc quản lý nhóm." Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <ListBox x:Name="ProjectGroupsList" ItemsSource="{Binding ProjectGroups}" SelectedItem="{Binding SelectedProjectGroup, Mode=TwoWay}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseRightButtonDown="ProjectGroupsList_PreviewMouseRightButtonDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="GroupCard" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GroupCard" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/></Trigger>
                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="GroupCard" Property="Background" Value="{DynamicResource AccentTintAltBrush}"/><Setter TargetName="GroupCard" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Path}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding PartCount}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="chi tiết" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding SheetCount}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="tấm" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel>
                                        <Button Grid.Column="3" Content="Mở nhóm" Tag="{Binding}" Click="OpenProjectGroup_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="ProjectGroupsContextMenu_Opened">
                                    <MenuItem Header="Tạo nhóm vật liệu…" Click="CreateProjectGroup_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Đổi tên nhóm…" Click="RenameProjectGroup_Click"/>
                                    <MenuItem Header="Nhân bản nhóm" Command="{Binding DuplicateProjectGroupCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Gỡ nhóm khỏi dự án" Click="RemoveProjectGroup_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <TextBlock Text="Gỡ nhóm chỉ bỏ liên kết khỏi dự án, file workspace vẫn được giữ lại." Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="2,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Part">
                <Grid Margin="24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Chi tiết" Style="{StaticResource SectionTitle}" FontSize="24"/>
                            <TextBlock Text="Quản lý danh sách sản xuất và thông tin vật liệu theo từng chi tiết." Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,18,0">
                            <Button Content="Thêm thư mục" Command="{Binding AddFolderCommand}"/>
                            <Button Content="Thư viện mẫu" Click="OpenStandardShapeLibrary_Click" IsEnabled="{Binding IsIdle}"/>
                            <Button Content="Thêm DXF" Command="{Binding AddDxfCommand}" Style="{StaticResource PrimaryButton}" Margin="0" ToolTip="Ctrl+D"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                            <StackPanel Margin="0,0,18,0"><TextBlock Text="MÃ CHI TIẾT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Parts.Count}" FontSize="17" FontWeight="Bold"/><TextBlock Text=" dòng" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="5,0,0,2"/></StackPanel></StackPanel>
                            <Border Width="1" Height="30" Background="{DynamicResource AppBorderBrush}" Margin="0,0,18,0"/>
                            <StackPanel Margin="0,0,18,0"><TextBlock Text="TỔNG SỐ LƯỢNG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding RequiredCount}" FontSize="17" FontWeight="Bold"/><TextBlock Text=" chi tiết" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="5,0,0,2"/></StackPanel></StackPanel>
                            <Border Width="1" Height="30" Background="{DynamicResource AppBorderBrush}" Margin="0,0,18,0"/>
                            <StackPanel MaxWidth="170"><TextBlock Text="NHÓM ĐANG LÀM VIỆC" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock Text="{Binding SelectedProjectGroup.Name, TargetNullValue='Chưa chọn nhóm'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3.5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardFlat}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="4,0,4,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Danh sách chi tiết" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Nhấp chuột phải để sửa thuộc tính, xóa hoặc chọn nhiều dòng." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="PartSelectionSummary" Text="Đã chọn 0 / 0 dòng" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Content="Chọn tất cả" Click="SelectAllParts_Click"/>
                                        <Button Content="Bỏ chọn" Click="ClearPartSelection_Click" Margin="0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1">
